# Recall Lab environment. Copy to .env and fill in your key.

# Required. OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-...

# Models (optional overrides).
# RECALL_AGENT_MODEL=openai/gpt-4o-mini
# RECALL_JUDGE_MODEL=anthropic/claude-sonnet-4.6

# --- OpenRouter provider routing (reproducibility pin) ---
# Pinned provider order for the agent model. OpenAI serves openai/gpt-4o-mini
# without the extra content filter that caused Azure's jailbreak false-positive.
RECALL_OPENROUTER_PROVIDER_ORDER=OpenAI
# Pinned provider for the Anthropic judge and contradiction classifier, so they
# land on one provider every run instead of whichever node load balances.
RECALL_OPENROUTER_JUDGE_PROVIDER_ORDER=Anthropic
# Off means a pinned call errors instead of silently switching providers mid-run.
RECALL_OPENROUTER_ALLOW_FALLBACKS=false
# Providers dropped on every call. Azure stays excluded so no model lands on it.
RECALL_OPENROUTER_IGNORE_PROVIDERS=Azure

# --- Client resilience (optional) ---
# RECALL_OPENROUTER_MAX_RETRIES=6
# RECALL_OPENROUTER_TIMEOUT=60

# --- Strong RAG control (optional) ---
# Date-window for the strong_rag_dated agent: how many days of history survive
# the metadata-by-date filter before reranking. Empty disables the hard filter
# and leaves timestamp recency only. Default 1.5.
# RECALL_STRONG_RAG_RECENCY_WINDOW_DAYS=1.5
